{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "headers": { "Authorization": "Bearer {env:FIRECRAWL_API_KEY}" }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true
    },
    "playwright-mobile": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser=webkit",
        "--viewport-size=430x932"
      ],
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:VERCEL_API_KEY}"
      }
    },
    "railway": {
      "type": "remote",
      "url": "https://mcp.railway.com",
      "enabled": true,
      "headers": { "Authorization": "Bearer {env:RAILWAY_API_TOKEN}" }
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "-y", "@sentry/mcp-server@0.39.0", "--access-token", "{env:SENTRY_AUTH_TOKEN}"],
      "enabled": true,
      "environment": {
        "SENTRY_ACCESS_TOKEN": "{env:SENTRY_AUTH_TOKEN}",
        "SENTRY_AUTH_TOKEN": "{env:SENTRY_AUTH_TOKEN}"
      }
    },
    "postgres-ahorar": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:AHORAR_DB_READONLY_URL}"],
      "enabled": true
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0",
    "@arkfactory/opencode-checkpoint@1.0.4",
    "opendesign@git+https://github.com/manalkaff/opendesign.git#v0.3.1"
  ],
  "permission": {
    "railway_*": "ask",
    "sentry_*": "ask",
    "vercel_*": "ask",
    "vercel_deploy_to_vercel": "ask",
    "github_*": "ask"
  }
}
